<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:LifeCommits.ViewModels"
        xmlns:views="using:LifeCommits.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="878" d:DesignHeight="285"
        x:Class="LifeCommits.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="LifeCommits"
        Width="878" Height="285"
        SystemDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        Topmost="False"
        >

    <Window.Styles>
        <Style Selector="Button:pointerover /template/ ContentPresenter">
            <Setter Property="Foreground" Value="White" />
        </Style>
    </Window.Styles>

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Canvas>
        
        <!--left-->
        <Button Background="#75000000" CornerRadius="10" ClipToBounds="True"
                Width="25" Height="150" Canvas.Left="0" Canvas.Top="135"
                Click="GoalPrev_Click">
            <TextBlock Text="&lt;" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Button>

        <!--right-->
        <Button Background="#75000000" CornerRadius="10" ClipToBounds="True"
                Width="25" Height="150" Canvas.Right="0" Canvas.Top="135"
                Click="GoalNext_Click">
            <TextBlock Text="&gt;" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Button>

        <!-- small year toggle buttons beside year selector -->
        <Button Background="#75000000" CornerRadius="5" ClipToBounds="True"
                Width="20" Height="30" Canvas.Left="27" Canvas.Top="100"
                Click="YearPrev_Click"
                Content="-" Padding="5" Foreground="White">
        </Button>
        <Button Background="#75000000" CornerRadius="5" ClipToBounds="True"
                Width="20" Height="30" Canvas.Left="133" Canvas.Top="100"
                Click="YearNext_Click"
                Content="+" Padding="4" Foreground="White">
        </Button>

        <!-- year display (show only current selected year) -->
        <Border Width="80" Height="30"
                Canvas.Left="50" Canvas.Top="100"
                Background="#75000000" CornerRadius="5" ClipToBounds="True">
            <TextBlock Text="{Binding SelectedYear}"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       FontFamily="Monospace"
                       FontWeight="Bold"
                       Foreground="White" />
        </Border>
        
        <!-- messages popup (shown when a square is clicked) -->
        <Border x:Name="MessagesPopup" IsVisible="False"
                Canvas.Left="0" Canvas.Top="0"
                MinWidth="180"
                MaxWidth="320"
                MaxHeight="300"
                Padding="8"
                Background="#85000000" CornerRadius="6" ClipToBounds="True">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="MessagesPanel" Margin="2" />
            </ScrollViewer>
        </Border>

        <!--Togglable Contribution panel-->
        <Border Background="#75000000" CornerRadius="10" ClipToBounds="True"
                Width="150" Height="130" Canvas.Right="190" Canvas.Top="0"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                IsVisible="{Binding IsContributePanelVisible}">
            <StackPanel Margin="10">
                 <TextBlock Text="Notes:" 
                           FontFamily="Monospace"
                           Foreground="White" 
                           FontWeight="Bold" 
                           Margin="5,0,0,5"/>
                <TextBox x:Name="ContributeTextBox" Width="120" Height="55" BorderThickness="0"/>
                <!-- Contribute -->
                <Button
                    Width="120" Height = "24"
                    Content="Contribute" 
                    FontFamily="Monospace"
                    FontWeight="Bold"
                    Click="ConfirmNewContribution_Click"
                    Padding="0,0,0,0"
                    Margin="5,5,0,0"
                    Background="#80FFFFFF"
                    Foreground="#80000000"
                    CornerRadius="5"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center" 
                />
            </StackPanel>
            
        </Border>

        <!-- Toggleable Goal Panel -->
        <Border Background="#75000000" CornerRadius="10" ClipToBounds="True"
                Width="150" Height="130" Canvas.Right="30" Canvas.Top="0"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                IsVisible="{Binding IsNewGoalPanelVisible}">
            <StackPanel Margin="10">
                <TextBlock Text="Goal:" 
                           FontFamily="Monospace"
                           Foreground="White" 
                           FontWeight="Bold" 
                           Margin="5,0,0,5"/>
                <TextBox x:Name="NewGoalTextBox" Width="120" Height="30" BorderThickness="0"/>
                
                <!-- color buttons -->
                <StackPanel Margin="7" Orientation="Horizontal">
                    <Button x:Name="ColorBtn0"
                    Width="12" Height = "12"
                    Background="#FF352E"
                    Margin="2"
                    Tag="0"
                    Click="ColorBtn_Click" />
                    
                    <Button x:Name="ColorBtn1"
                        Width="12" Height = "12"
                        Background="#FF9D00"
                        Margin="2"
                        Tag="1"
                        Click="ColorBtn_Click" />

                    <Button x:Name="ColorBtn2"
                        Width="12" Height = "12"
                        Background="#FFE72E"
                        Margin="2"
                        Tag="2"
                        Click="ColorBtn_Click" />

                    <Button x:Name="ColorBtn3"
                        Width="12" Height = "12"
                        Background="#6DDB24"
                        Margin="2"
                        Tag="3"
                        Click="ColorBtn_Click" />

                    <Button x:Name="ColorBtn4"
                        Width="12" Height = "12"
                        Background="#4BABE2"
                        Margin="2"
                        Tag="4"
                        Click="ColorBtn_Click" />

                    <Button x:Name="ColorBtn5"
                        Width="12" Height = "12"
                        Background="#8F24DB"
                        Margin="2"
                        Tag="5"
                        Click="ColorBtn_Click" />

                    <Button x:Name="ColorBtn6"
                        Width="12" Height = "12"
                        Background="#DB24DB"
                        Margin="2"
                        Tag="6"
                        Click="ColorBtn_Click" />
                </StackPanel>

                <!-- submit new goal-->
                <Button
                    Width="120" Height = "24"
                    Content="Create" 
                    FontFamily="Monospace"
                    FontWeight="Bold"
                    Click="ConfirmNewGoal_Click"
                    Padding="0,-2,0,0"
                    Margin="5,0,0,0"
                    Background="#80FFFFFF"
                    Foreground="#80000000"
                    CornerRadius="5"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center" 
                />

              
            </StackPanel>
        </Border>
        
        
        
        
		

        <!-- main panel-->
        <Border Background="#75000000" CornerRadius="10" PointerPressed="OnPointerPressed" ClipToBounds="True"
                Width="820" Height="150" Canvas.Left="29" Canvas.Top="135">

            <Grid>
                <!--grid squares -->
                <views:GridRenderer x:Name="GridRenderer" GridToDraw="{Binding SelectedGrid}" 
                                    HorizontalAlignment="Center" 
                                    VerticalAlignment="Bottom" 
                                    Width="795" 
                                    Height="100"
                                    Margin="15,35,10,10" />

                <!-- current goal/'Overview' -->
                <TextBlock Text="{Binding CurrentTitle}" 
                           FontFamily="Monospace"
                           Foreground="White" 
                           FontWeight="Bold" 
                           FontSize="20"
                           HorizontalAlignment="Left" 
                           VerticalAlignment="Top" 
                           Margin="10,5,0,0" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="5">
                    <!--contribute-->
                    <Button 
                        IsVisible="{Binding IsContributeButtonVisible}"
                        Content="Contribute" 
                        FontFamily="Monospace"
                        FontWeight="Bold"
                        Click="ShowContributePanel_Click"
                        Width="100" Height="20"
                        Padding="0,-1,0,0"
                        Margin="0,5,5,0"
                        Background="#90FFFFFF"
                        Foreground="#80000000"
                        CornerRadius="5"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center" />
                    <!--new goal-->
                    <Button 
                        Content="New Goal" 
                        FontFamily="Monospace"
                        FontWeight="Bold"
                        Click="ShowNewGoalPanel_Click"
                        Width="90" Height="20"
                        Padding="0,-1,0,0"
                        Margin="0,5,5,0"
                        Background="#90FFFFFF"
                        Foreground="#80000000"
                        CornerRadius="5"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center" />
                    <!--minimize-->
                    <Button Content="&#8211;" 
                            FontFamily="Monospace"
                            FontWeight="Bold"
                            Click="MinimizeButton_Click"
                            Width="20" Height="20"
                            Padding="0,-2,0,0"
                            Margin="0,5,5,0"
                            Background="#90FFFFFF"
                            Foreground="#80000000"
                            CornerRadius="5"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center" />
                    <!--close-->
                    <Button Content="x" 
                            FontFamily="Monospace"
                            FontWeight="Bold"
                            Click="CloseButton_Click"
                            Width="20" Height="20"
                            Padding="0,-2,0,0"
                            Margin="0,5,5,0"
                            Background="#90FFFFFF"
                            Foreground="#80000000"
                            CornerRadius="5"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center" />
                 
                </StackPanel>
            </Grid>
        </Border>
    </Canvas>

</Window>
